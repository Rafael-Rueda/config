{
	"$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
	"root": false,
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"src/**/*.{js,ts,jsx,tsx}",
			"test/**/*.{js,ts,jsx,tsx}",
			"database/**/*.{js,ts,jsx,tsx}",
			"prisma/**/*.{js,ts,jsx,tsx,prisma}",
			"src/**/*.test.*",
			"src/**/*.spec.*",
			"!**/*.min.js",
			"*.config.*",
			"*.json",
			"server.{js,ts}",
			".vscode/settings.json",
			"**/*.{js,ts,jsx,tsx}"
		],
		"ignoreUnknown": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"indentWidth": 4,
		"lineWidth": 120,
		"lineEnding": "lf"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedVariables": "off",
				"noUnusedImports": "off",
				"noUnusedFunctionParameters": "off"
			},
			"nursery": {
				"useSortedClasses": {
					"level": "info",
					"options": {
						"attributes": ["class", "className"],
						"functions": ["clsx", "cva", "tw", "tw.*"]
					}
				}
			},
			"style": {
				"noNonNullAssertion": "off"
			}
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							":NODE:",
							":PACKAGE:",
							":BLANK_LINE:",
							"@/components/**",
							"@/utils/**",
							":BLANK_LINE:",
							"./**"
						]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all",
			"arrowParentheses": "always",
			"bracketSpacing": true,
			"jsxQuoteStyle": "double"
		},
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	},
	"html": {
		"formatter": { "enabled": true },
		"experimentalFullSupportEnabled": true
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": ["**/*.{test,spec}.{js,ts,jsx,tsx}"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off"
					}
				}
			}
		}
	]
}
